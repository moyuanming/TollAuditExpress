# 数据库配置（远程 MySQL/StarRocks）
DB_HOST=
DB_PORT=9030
DB_USER=
DB_PASSWORD=
DB_NAME=dwd_tolldata

# 外部工具路径
GETMOVEOBU_PATH=
MODEL_PATH=

# LLM API Keys（按需配置，留空则跳过对应检测）
ZHIPU_API_KEY=
DOUBAO_API_KEY=
QWEN_API_KEY=
MAAS_API_KEY=
MAAS_MODEL=qwen2.5-vl-72b
MAAS_API_URL=https://api.modelarts-maas.com/v1/chat/completions
LLM_TIMEOUT=60

# 车辆部件检测模型（需自定义训练模型）
VEHICLE_PART_MODEL_PATH=

# CORS（逗号分隔）
CORS_ORIGINS=http://localhost:3000

# 鉴权（留空则跳过鉴权，仅用于开发）
API_KEY=

# 日志
LOG_LEVEL=INFO
