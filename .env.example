# 数据库配置 — 源库（远程 MySQL/StarRocks,只读原始通行流水）
DB_HOST=
DB_PORT=9030
DB_USER=
DB_PASSWORD=
DB_NAME=dwd_tolldata

# 数据库配置 — 审计目标库(迁移目的地,承载 SQLite 全部派生表)
# 与源库可在同一台 Doris(不同 DB),也可不同实例
DB_AUDIT_HOST=
DB_AUDIT_PORT=9030
DB_AUDIT_USER=
DB_AUDIT_PASSWORD=
DB_AUDIT_NAME=ods_AI_DB

# 外部工具路径
GETMOVEOBU_PATH=
MODEL_PATH=

# 车辆 AI 公共服务（独立部署在目标机同台 8081 端口）
# 默认 http://10.11.1.40:8081; 本地开发可改为 http://localhost:8081
# docker 内调用时改为 http://host.docker.internal:8081
VEHICLE_AI_SERVICE_URL=http://10.11.1.40:8081
VEHICLE_AI_SERVICE_TIMEOUT=65

# LLM API Keys — 仅在公共服务中需要,主项目不再直接调用 LLM
# 这些配置项保留在 .env.example 中以便部署公共服务时使用

# LLM API Keys（按需配置，留空则跳过对应检测）
ZHIPU_API_KEY=
DOUBAO_API_KEY=
QWEN_API_KEY=
MAAS_API_KEY=
MAAS_MODEL=qwen2.5-vl-72b
MAAS_API_URL=https://api.modelarts-maas.com/v1/chat/completions
LLM_TIMEOUT=60

# 车辆部件检测模型（需自定义训练模型）
VEHICLE_PART_MODEL_PATH=

# CORS（逗号分隔）
CORS_ORIGINS=http://localhost:3000

# 鉴权（留空则跳过鉴权，仅用于开发）
API_KEY=

# 日志
LOG_LEVEL=INFO

# OAuth / JWT 统一登录平台配置
AUTH_ENABLED=false
AUTH_JWT_SERVICE_BASE_URL=http://<platform>:9000/api/auth-jwt
AUTH_JWT_CLIENT_ID=<client-id>
AUTH_JWT_CLIENT_SECRET=<client-secret>
AUTH_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
AUTH_LOGIN_URL=http://<platform>:9000/portal-web
