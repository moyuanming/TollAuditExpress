# TollAuditExpress 部署配置
# 拷贝为 deploy.config.env 后填写实际值；本文件可入库。
# deploy.config.env 已在 .gitignore 中，不会被提交。

# --- 三机拓扑 ---
# 本地 macOS：你当前所在的开发机；同时连得上下面两台
# 构建服务器：负责 docker build 多阶段镜像
# 运行服务器：承载最终容器
# 约束：构建机 <-> 运行机 网络不通，必须经本地 macOS 中转

BUILD_SERVER=root@<build-server-ip>
TARGET_SERVER=root@<target-server-ip>

# --- 路径 ---
BUILD_DIR=/opt/toll-audit-build       # 构建机上拉源码、跑 docker build 的目录
TARGET_DIR=/opt/toll-audit            # 运行机上持久化数据、挂载 .env、日志的位置

# --- 镜像 / 容器 ---
IMAGE_NAME=toll-audit-express:latest
CONTAINER_NAME=toll-audit-express
# 目标机默认 8000；如果端口被占用（如 sqlbot 占了 8000），改成空闲端口（如 8080）
SERVICE_PORT=8000

# --- SSH 行为 ---
# 留空表示用 ssh 默认参数
SSH_OPTS="-o StrictHostKeyChecking=accept-new -o ConnectTimeout=10"

# --- ML 模型 ---
# 本地 best_model.pth 路径（客货车分类模型），部署时会推送到目标机
LOCAL_MODEL_PATH=/Users/moyuanming/getmoveobu/best_model.pth
# 本地 resnet50 权重路径（车纹识别特征提取），部署时会推送到目标机
LOCAL_RESNET50_PATH=$HOME/.cache/torch/hub/checkpoints/resnet50-0676ba61.pth
